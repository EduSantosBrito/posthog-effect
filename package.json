{
  "name": "posthog-effect",
  "version": "0.0.0-canary.1",
  "description": "Effect-native PostHog SDK for Effect v4 beta.",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist coverage",
    "dev": "vite build --watch",
    "build": "bun run clean && vite build && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "effect": "4.0.0-beta.51"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.4.0",
    "@effect/vitest": "4.0.0-beta.51",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.7.2",
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
